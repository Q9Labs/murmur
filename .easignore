# Keep EAS archives deterministic and limited to build inputs.
node_modules/
.git/
.worktrees/
.asc/
.expo/
.wrangler/
.fallow/
dist/
web-build/
coverage/
scratchpad/
.logs/

# Native projects are generated by EAS prebuild.
/apps/mobile/ios/
/apps/mobile/android/
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/ios/build/

# Store publishing assets are not runtime inputs.
/apps/mobile/fastlane/
/apps/mobile/store-assets/

# Local credentials and environment files.
credentials.json
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem
.dev.vars
.env
.env*.local
*.tsbuildinfo
*.orig.*

# Local/tooling-only material.
docs/
.github/
release/
.semgrep/
.vm/
*.log
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
