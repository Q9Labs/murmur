{
  "name": "murmur",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "worker:dev": "wrangler dev",
    "worker:types": "tsc --noEmit -p worker/tsconfig.json",
    "smoke:latency": "node scripts/smoke-latency.mjs",
    "store:secrets": "node scripts/validate-no-secrets.mjs",
    "store:live": "node scripts/validate-production-worker.mjs",
    "store:config": "node scripts/validate-app-config.mjs",
    "store:blockers": "node scripts/validate-submission-blockers.mjs",
    "store:metadata": "node scripts/validate-ios-metadata.mjs && node scripts/validate-android-metadata.mjs && node scripts/validate-store-assets.mjs",
    "store:preflight": "pnpm test && pnpm store:secrets && pnpm store:config && pnpm audit --audit-level moderate && pnpm dlx expo-doctor && pnpm store:metadata && fastlane ios validate_app_store_submission && fastlane android validate_play_submission",
    "store:submission-readiness": "pnpm store:preflight && pnpm store:live",
    "store:launch-ready": "pnpm store:submission-readiness && pnpm store:blockers",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "test": "pnpm typecheck && pnpm worker:types && pnpm unit"
  },
  "dependencies": {
    "@bradford-tech/supabase-integrity-attest": "^0.8.2",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.12",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260516.1",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^2.0.2",
      "ws": "^8.20.1",
      "postcss": "^8.5.14"
    }
  },
  "private": true,
  "packageManager": "pnpm@10.26.2"
}
