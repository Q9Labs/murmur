{
  "name": "murmur",
  "description": "A privacy-conscious, one-way live translation app built with Expo and Cloudflare Workers.",
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Q9Labs/murmur.git"
  },
  "homepage": "https://murmur.q9labs.ai",
  "bugs": {
    "url": "https://github.com/Q9Labs/murmur/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run start",
    "start": "node tooling/scripts/dev-log.mjs start:raw",
    "start:raw": "pnpm --filter @murmur/mobile start",
    "android": "pnpm --filter @murmur/mobile android",
    "ios": "pnpm --filter @murmur/mobile ios",
    "dev:worker": "pnpm run worker:dev",
    "worker:dev": "node tooling/scripts/dev-log.mjs worker:dev:raw",
    "worker:dev:raw": "pnpm --filter @murmur/worker dev",
    "worker:deploy:development": "pnpm --filter @murmur/worker deploy:development",
    "worker:deploy:production": "pnpm --filter @murmur/worker deploy:production",
    "gate": "bash tooling/gates/commit.sh",
    "gate:explain": "sed -n '1,240p' tooling/gates/README.md",
    "hooks:install": "lefthook install",
    "review:commit": "bash tooling/gates/post-commit-review.sh",
    "gate:hygiene": "node tooling/gates/hygiene.mjs",
    "static:fallow": "fallow audit",
    "static:fallow:health": "fallow health --score --hotspots --targets --min-score ${FALLOW_MIN_SCORE:-45}",
    "static:semgrep": "node tooling/gates/require-tool.mjs semgrep \"Install the official Semgrep CLI, then rerun pnpm run static:semgrep.\" && semgrep scan --config .semgrep --error",
    "security:secrets": "node tooling/gates/require-tool.mjs gitleaks \"Install the official Gitleaks CLI, then rerun pnpm run security:secrets.\" && gitleaks detect --source . --redact --verbose",
    "security:osv": "node tooling/gates/require-tool.mjs osv-scanner \"Install the official OSV-Scanner CLI, then rerun pnpm run security:osv.\" && osv-scanner scan source -r --experimental-exclude scratchpad .",
    "deps:syncpack": "syncpack lint --specifier-types missing,unsupported",
    "lint:spelling": "cspell apps/mobile/app apps/mobile/src apps/worker/src packages/protocol/src tooling package.json README.md AGENTS.md CONTRIBUTING.md docs/*.md docs/legal/*.md",
    "react:doctor": "cd apps/mobile && pnpm dlx expo-doctor@1.20.0",
    "test:presence": "node tooling/gates/test-presence.mjs",
    "worker:types": "pnpm --filter @murmur/worker typecheck",
    "smoke:latency": "node tooling/scripts/smoke-latency.mjs",
    "store:secrets": "node tooling/scripts/validate-no-secrets.mjs",
    "store:live": "node tooling/scripts/validate-production-worker.mjs",
    "store:config": "node tooling/scripts/validate-app-config.mjs",
    "store:blockers": "node tooling/scripts/validate-submission-blockers.mjs",
    "store:blockers:closed": "node tooling/scripts/validate-submission-blockers.mjs --require-closed",
    "store:metadata": "node tooling/scripts/validate-ios-metadata.mjs && node tooling/scripts/validate-android-metadata.mjs && node tooling/scripts/validate-store-assets.mjs",
    "store:screenshots:test": "node --test tooling/scripts/build-store-screenshots.test.mjs tooling/scripts/store-screenshot-validation.test.mjs",
    "store:preflight": "pnpm test && pnpm store:secrets && pnpm store:config && pnpm audit --audit-level moderate && pnpm react:doctor && pnpm store:metadata && (cd apps/mobile && fastlane ios validate_app_store_submission && fastlane android validate_play_submission)",
    "store:submission-readiness": "pnpm store:preflight && pnpm store:live",
    "store:launch-ready": "pnpm store:submission-readiness && pnpm store:blockers:closed",
    "typecheck": "pnpm --filter \"@murmur/*\" run typecheck",
    "tooling:test": "node --test tooling/scripts/smoke-latency.test.mjs tooling/scripts/submission-blockers.test.mjs",
    "unit": "pnpm --filter \"@murmur/*\" run unit && pnpm run store:screenshots:test && pnpm run tooling:test",
    "test:coverage": "pnpm --filter \"@murmur/*\" exec vitest run --coverage",
    "coverage": "pnpm run test:coverage",
    "test": "pnpm typecheck && pnpm worker:types && pnpm unit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.6",
    "cspell": "10.0.1",
    "fallow": "2.96.0",
    "lefthook": "2.1.9",
    "syncpack": "15.3.1",
    "typescript": "~5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.26.2"
}
