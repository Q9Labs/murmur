{
  "name": "murmur",
  "description": "A privacy-conscious, one-way live translation app built with Expo and Cloudflare Workers.",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Q9Labs/murmur.git"
  },
  "homepage": "https://murmur.q9labs.ai",
  "bugs": {
    "url": "https://github.com/Q9Labs/murmur/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "worker:dev": "wrangler dev",
    "experiment:benchmark": "node scripts/benchmark-translation-experiments.mjs",
    "gate": "bash scripts/gates/commit.sh",
    "gate:explain": "sed -n '1,240p' scripts/gates/README.md",
    "hooks:install": "lefthook install",
    "review:commit": "bash scripts/gates/post-commit-review.sh",
    "gate:hygiene": "node scripts/gates/hygiene.mjs",
    "static:fallow": "fallow audit",
    "static:fallow:health": "fallow health --score --hotspots --targets --min-score ${FALLOW_MIN_SCORE:-45}",
    "static:semgrep": "node scripts/gates/require-tool.mjs semgrep \"Install the official Semgrep CLI, then rerun pnpm run static:semgrep.\" && semgrep scan --config .semgrep --error",
    "security:secrets": "node scripts/gates/require-tool.mjs gitleaks \"Install the official Gitleaks CLI, then rerun pnpm run security:secrets.\" && gitleaks detect --source . --redact --verbose",
    "security:osv": "node scripts/gates/require-tool.mjs osv-scanner \"Install the official OSV-Scanner CLI, then rerun pnpm run security:osv.\" && osv-scanner scan source -r --experimental-exclude scratchpad .",
    "deps:syncpack": "syncpack lint --source package.json --specifier-types missing,unsupported",
    "lint:spelling": "cspell app lib services worker/src scripts package.json README.md AGENTS.md docs/*.md docs/legal/*.md",
    "test:presence": "node scripts/gates/test-presence.mjs",
    "worker:types": "tsc --noEmit -p worker/tsconfig.json",
    "smoke:latency": "node scripts/smoke-latency.mjs",
    "store:secrets": "node scripts/validate-no-secrets.mjs",
    "store:live": "node scripts/validate-production-worker.mjs",
    "store:config": "node scripts/validate-app-config.mjs",
    "store:blockers": "node scripts/validate-submission-blockers.mjs",
    "store:metadata": "node scripts/validate-ios-metadata.mjs && node scripts/validate-android-metadata.mjs && node scripts/validate-store-assets.mjs",
    "store:preflight": "pnpm test && pnpm store:secrets && pnpm store:config && pnpm audit --audit-level moderate && pnpm dlx expo-doctor && pnpm store:metadata && fastlane ios validate_app_store_submission && fastlane android validate_play_submission",
    "store:submission-readiness": "pnpm store:preflight && pnpm store:live",
    "store:launch-ready": "pnpm store:submission-readiness && pnpm store:blockers",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm typecheck && pnpm worker:types && pnpm unit"
  },
  "dependencies": {
    "@bradford-tech/supabase-integrity-attest": "^0.8.2",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.12",
    "expo-file-system": "~19.0.23",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260516.1",
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "4.1.6",
    "babel-preset-expo": "~54.0.10",
    "cspell": "10.0.1",
    "fallow": "2.96.0",
    "lefthook": "2.1.9",
    "syncpack": "15.3.1",
    "typescript": "~5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "brace-expansion": "^2.0.2",
      "esbuild": "^0.28.1",
      "js-yaml": "^4.2.0",
      "shell-quote": "^1.8.4",
      "tar": "^7.5.16",
      "uuid": "11.1.1",
      "vite": "^8.0.16",
      "ws": "^8.21.0",
      "postcss": "^8.5.14",
      "undici@<7": "^6.27.0",
      "undici@>=7": "^7.28.0"
    }
  },
  "private": true,
  "packageManager": "pnpm@10.26.2"
}
