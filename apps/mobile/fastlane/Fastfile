default_platform(:ios)

platform :android do
  desc "Validate Google Play metadata consistency, screenshots, signing, and the current release bundle locally"
  lane :validate_play_submission do
    sh("../../../tooling/scripts/check-android-release-signing.sh")
    sh("cd ../../.. && node tooling/scripts/validate-android-metadata.mjs")

    ["en-US", "en-GB"].each do |locale|
      sh("gplay validate listing --dir ../fastlane/metadata/android --locale #{locale} -output table")
      sh("gplay validate screenshots --dir ../fastlane/metadata/android --locale #{locale} -output table")
    end

    sh("APKSIGNER=\"$(find \"$ANDROID_HOME/build-tools\" -name apksigner -type f | sort -V | tail -1)\" && \"$APKSIGNER\" verify --verbose --print-certs ../android/app/build/outputs/apk/release/app-release.apk | grep -q 'Signer #1 certificate SHA-256 digest'")
    sh("jarsigner -verify -certs -verbose ../android/app/build/outputs/bundle/release/app-release.aab | grep -q 'jar verified'")
    sh("gplay validate bundle --file ../android/app/build/outputs/bundle/release/app-release.aab -output table")
  end
end

platform :ios do
  desc "Validate iOS submission metadata, plist files, and tracked App Privacy config locally"
  lane :validate_app_store_submission do
    sh("cd .. && pnpm exec expo config --type public >/tmp/murmur-expo-config-fastlane.json")
    sh("cd .. && pnpm exec vitest run plugins/iosPrivacyManifestConfig.test.ts")
    sh("cd ../../.. && node tooling/scripts/validate-ios-metadata.mjs")
    sh("plutil -lint ../ios/murmur/Info.plist ../ios/murmur/PrivacyInfo.xcprivacy ../ios/murmur/murmur.entitlements")
  end
end
