# Cloudflare Worker vars/secrets.
# Copy this file to .dev.vars for local development. Set hosted secrets with Wrangler.
MURMUR_ENV=development
MURMUR_REQUIRE_DEVICE_INTEGRITY=false
BILLING_ENFORCEMENT_ENABLED=false
SESSION_HASH_SALT=replace-with-random-secret-salt
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787/api/auth
APPLE_CLIENT_ID=replace-with-apple-services-id
APPLE_APP_BUNDLE_IDENTIFIER=com.q9labsai.murmur
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-sign-in-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-apple-sign-in-key\n-----END PRIVATE KEY-----\n"
GOOGLE_WEB_CLIENT_ID=replace-with-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=replace-with-ios-oauth-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=replace-with-android-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-web-oauth-client-secret
EMAIL_FROM=Murmur <login@murmur.q9labs.ai>
RESEND_API_KEY=re_replace-with-server-side-key
REVENUECAT_API_KEY=sk_v2_replace-with-read-only-key
REVENUECAT_PROJECT_ID=projc52a5a19
REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-random-webhook-authorization
REVENUECAT_WEBHOOK_SIGNING_SECRET=replace-with-random-hmac-secret

GOOGLE_PLAY_PACKAGE_NAME=com.q9labsai.murmur
GOOGLE_PLAY_INTEGRITY_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
GOOGLE_SERVICE_ACCOUNT_EMAIL=play-integrity-verifier@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"
APPLE_APP_ATTEST_APP_ID=TEAMID.com.q9labsai.murmur
APPLE_APP_ATTEST_ENVIRONMENT=production

OPENAI_API_KEY=server-side-only
OPENAI_REALTIME_MODEL=gpt-realtime-translate

# PostHog US project token. Mobile events reach PostHog only through this Worker.
POSTHOG_PROJECT_TOKEN=phc_replace-with-project-token

# Sentry Worker project DSN. The release is set by the release deployment script.
SENTRY_DSN=https://replace-with-public-dsn@o0.ingest.de.sentry.io/0
SENTRY_RELEASE=murmur-worker@1.2.0+local

# Optional webhook. REPORT_ADMIN_TOKEN is the required fallback for operational triage.
REPORT_WEBHOOK_URL=https://example.invalid/murmur-report-webhook
REPORT_ADMIN_TOKEN=server-side-random-admin-token
